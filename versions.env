# versions.env — single source of truth for pinned tool versions (Phase 1).
#
# Checked against the projects' official release pages on 2026-09-20.
# Change ONE version at a time, run `make doctor && make test && make smoke`,
# then commit. The k3s (Kubernetes) image is pinned in deploy/k3d/cluster.yaml;
# tests/bootstrap/test_static.sh checks that kubectl stays within one minor
# version of it (Kubernetes version-skew policy).

K3D_VERSION=v5.9.0
# kubectl must be within one minor of the cluster's Kubernetes version.
# The cluster is pinned to 1.34 (see ADR-16: WSL2 kernel 5.15 uses cgroup v1,
# which Kubernetes >= 1.35 refuses by default). Keep this at v1.34.x until ADR-16 is closed.
KUBECTL_VERSION=v1.34.10
HELM_VERSION=v4.3.0

# Image used only by `make smoke` (a tiny HTTP echo server).
# If this tag cannot be pulled, override it: SMOKE_IMAGE=traefik/whoami:latest make smoke
SMOKE_IMAGE=traefik/whoami:v1.10.3

# --- Phase 3: container image and scanner ---------------------------------------------------
# Base image tag. The Debian release is named on purpose: `python:3.12-slim` currently points at
# trixie (docker-library/official-images, checked 2026-09-21), and a change of Debian release
# should be a visible edit. app/ai_service/Dockerfile has the same default; `make test` checks
# that the two agree.
PYTHON_BASE_TAG=3.12-slim-trixie
# Digest pin for the base image (sha256:<64 hex>), printed by `make image-pin` on a machine that
# can reach Docker Hub and committed here (2026-09-21). Bump it deliberately: run `make image-pin`,
# paste the new value, rebuild, rescan and update docs/security/image-scan.md. If emptied, the
# build still works but is not reproducible, and `make image-build` says so.
PYTHON_BASE_DIGEST=sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9

# Scanner used by `make image-scan` and `make image-sbom`, run as a container so nothing is
# installed on the host. 0.74.0 is the latest release listed on the project's releases page on
# 2026-09-21 (published 2026-08-14). Versions 0.69.4, 0.69.5 and 0.69.6 were malicious builds
# (GHSA-69fq-xp46-6x23, March 2026); `make test` refuses them. Never use a floating tag.
TRIVY_IMAGE=ghcr.io/aquasecurity/trivy
TRIVY_VERSION=0.74.0
# Optional digest pin, same procedure as PYTHON_BASE_DIGEST (`make image-pin`).
TRIVY_IMAGE_DIGEST=sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969

# --- Phase 6: CI pipeline (secret scanning, dependency audit, workflow lint) ----------------
# gitleaks (secret scanning) and actionlint (GitHub Actions workflow linting) are installed the
# same way as k3d/kubectl/helm (scripts/ci/*.sh, checksum-verified download, no sudo). The
# sandbox this project was built in cannot reach the GitHub REST API (api.github.com is
# repository-scoped for this session) to ask for "latest", so these were pinned by probing
# specific release-asset download URLs directly and verifying each one's sha256 against the
# project's own published checksums file on 2026-09-22 — real downloads, real checksum matches,
# not guessed. Bump deliberately, the same way as every other pin in this file.
GITLEAKS_VERSION=v8.30.0
ACTIONLINT_VERSION=v1.7.12

# pip-audit (dependency vulnerability audit) and yamllint (YAML style/syntax) are pure-Python and
# installed from PyPI (reachable from the sandbox, unlike get.helm.sh/dl.k8s.io/ghcr.io) into a
# throwaway virtualenv by scripts/ci/deps-audit.sh and scripts/ci/workflow-lint.sh. Pinned exactly,
# same reasoning as app/ai_service/requirements*.txt.
PIP_AUDIT_VERSION=2.10.1
YAMLLINT_VERSION=1.38.0

# --- Phase 8: GitOps control plane (Argo CD) ------------------------------------------------
# Latest stable release on the project's GitHub releases page, checked for real on 2026-09-23:
# v3.5.2, published 2026-08-27 (other recent stables at the time: v3.5.1, v3.4.8, v3.4.7,
# v3.3.14, v3.5.0). Argo CD is not installed as a local binary like k3d/kubectl/helm above — it
# is applied straight into the cluster from the project's official install manifest
# (manifests/install.yaml), which has no published checksums file to verify against, unlike
# k3d/kubectl/gitleaks/actionlint's release assets. So this pin works like
# PYTHON_BASE_DIGEST/TRIVY_IMAGE_DIGEST above: raw.githubusercontent.com is reachable from this
# sandbox (unlike get.helm.sh/dl.k8s.io), so the manifest for this exact tag was downloaded for
# real, its sha256 computed and committed here, and scripts/bootstrap/argocd.sh verifies every
# future download against this fixed value before applying anything to the cluster — an
# unexpected change (re-tagged release, compromised mirror) fails loudly instead of silently
# applying different YAML than was ever reviewed. Bump deliberately: change ARGOCD_VERSION,
# download the new manifest, recompute its sha256, update it here, then `make argocd-install` on
# a real cluster.
ARGOCD_VERSION=v3.5.2
ARGOCD_INSTALL_SHA256=9a87f2b3e14c278f12501eb0ef5c3955b27cf05370ca425381c6a908cf85a5c5

# --- Phase 9: Observability (kube-prometheus-stack, Loki, Tempo, OTel Collector) -----------
# All four are installed by scripts/bootstrap/observability.sh via `helm install`, not local
# binaries, so these pins are chart versions (the --version flag), not tool release tags.
#
# kube-prometheus-stack and the OTel Collector chart: pinned exactly, same as every other
# version in this file. Verified for real against each chart's own Chart.yaml on
# raw.githubusercontent.com on 2026-09-23 (repo index pages themselves, *.github.io, are not
# reachable from this sandbox, same as ARGOCD_VERSION's manifest URL above and get.helm.sh/
# dl.k8s.io -- raw.githubusercontent.com is, so the pin was verified against the tagged chart's
# actual Chart.yaml rather than guessed from a version number seen somewhere else).
KUBE_PROMETHEUS_STACK_VERSION=91.5.0
OTEL_COLLECTOR_CHART_VERSION=0.173.1

# Loki and Tempo: deliberately left UNPINNED. Both charts moved from grafana/helm-charts to a
# community-maintained fork, grafana-community/helm-charts, during 2026 (Tempo on 2026-01-30,
# Loki on 2026-03-16 -- both dates confirmed from that repo's own README migration notices and
# Grafana's "Upgrade to the community Helm chart" doc, checked for real on 2026-09-23). The new
# repo releases fast enough that three checks made minutes apart on 2026-09-23 already disagreed
# (Loki's Chart.yaml showed 18.11.7 once and 18.13.5 the next fetch); pinning either version
# number here would very likely already be wrong by the time this is read. Same reasoning as
# PYTHON_BASE_DIGEST above being allowed to stay empty: scripts/bootstrap/observability.sh
# installs Loki/Tempo without --version, prints the actually-installed version prominently
# (`helm list -n observability`), and the next step is a deliberate follow-up commit pinning
# LOKI_CHART_VERSION/TEMPO_CHART_VERSION here from that real output -- not guessed at now.
#
# Pinned below from the real, resolved versions on the target machine (2026-09-24, `helm list -n
# observability` output: loki-18.13.5 / tempo-3.0.0). From this commit on, scripts/bootstrap/
# observability.sh installs these two exact versions instead of floating -- reproducible the same
# way KUBE_PROMETHEUS_STACK_VERSION/OTEL_COLLECTOR_CHART_VERSION already were. Bump deliberately,
# same procedure as every other pin in this file, not by leaving this blank again.
LOKI_CHART_VERSION=18.13.5
TEMPO_CHART_VERSION=3.0.0
LOKI_HELM_REPO=https://grafana-community.github.io/helm-charts
TEMPO_HELM_REPO=https://grafana-community.github.io/helm-charts

# --- Phase 11: AI model serving (Ollama) ----------------------------------------------------
# ollama/ollama has no published checksums file the way k3d/kubectl/gitleaks/actionlint's release
# assets do, and this sandbox cannot reach Docker Hub directly (no Docker daemon here either --
# confirmed by trying, not assumed; see docs/troubleshooting.md, Phase 11) to verify a digest the
# way PYTHON_BASE_DIGEST/TRIVY_IMAGE_DIGEST were. What IS verified for real: the version number
# itself, from the project's own GitHub releases page (github.com/ollama/ollama/releases),
# fetched on 2026-09-29 -- latest release v0.34.4, published 2026-09-23, no security advisories
# noted against it. The Docker Hub tag format (no "v" prefix, e.g. "0.1.9", "0.1.12") is inferred
# from that project's own historical tag listing, not directly confirmed against hub.docker.com
# from this sandbox (blocked by the proxy, same as ollama.com itself). If `make model-serving-
# install` fails with "manifest unknown" for this tag, that inference was wrong -- confirm the
# real tag with `curl -s https://hub.docker.com/v2/repositories/ollama/ollama/tags | ...` on the
# target machine and correct this line, the same "resolve for real, then pin" step this file's
# Phase 9 section already documents for Loki/Tempo.
OLLAMA_IMAGE_TAG=0.34.4

# The k3d agent nodes cannot resolve Docker Hub directly (DNS failures confirmed on the
# target machine, 2026-09-29/30 -- see docs/troubleshooting.md, Phase 11). Confirmed, working
# fallback: push the image to k3d's own local registry (registry.localhost:5000, created
# automatically with every k3d cluster) and point the install script there instead. Empty by
# default -- then pulls straight from Docker Hub, the documented, unmodified upstream path;
# set only to the local registry's in-cluster address, the confirmed fallback for this
# specific network.
OLLAMA_IMAGE_REGISTRY=registry.localhost:5000

# The model POST /v1/chat actually answers with once POLARIS_BACKEND=openai_compat. Chosen and
# verified for real (WebFetch against ollama.com/library/llama3.2/tags, 2026-09-29): Meta's
# Llama 3.2, 1B-parameter variant, "instruct" (not "text") since /v1/chat is a chat/instruct
# workload, q4_K_M quantization -- 808 MB download, a reasonable size/quality trade-off among the
# eleven 1B quantizations Ollama's library actually lists (581 MB q2_K up to 2.5 GB fp16). A
# fully-qualified tag on purpose (never the bare "llama3.2:1b", which silently maps to whichever
# quantization Ollama's library treats as that tag's default) -- the same "never a floating tag"
# discipline as PYTHON_BASE_TAG/TRIVY_VERSION above, applied to a model tag instead of an image
# tag. helm/ai-platform/values-dev.yaml's config.POLARIS_OPENAI_MODEL must match this exactly;
# tests/bootstrap/test_static.sh checks that it does.
OLLAMA_MODEL=llama3.2:1b-instruct-q4_K_M

# --- Phase 13: FinOps (OpenCost) --------------------------------------------------------------
# OpenCost's own Helm chart repo is a *.github.io page (opencost.github.io/opencost-helm-chart),
# the same category of repo-index page this file's Phase 9 section already documents as
# unreachable from this sandbox (grafana-community.github.io, same reason Loki/Tempo are left
# unpinned) -- *.github.io pages are not reachable here, unlike raw.githubusercontent.com. So the
# exact same two-step applied: OPENCOST_CHART_VERSION started EMPTY on purpose,
# scripts/bootstrap/finops.sh installed without --version and printed whatever Helm actually
# resolved. On the real target machine (Darya, 2026-10-08) that resolved to opencost-2.5.32,
# now pinned below in this deliberate follow-up commit -- never guessed at, read straight off
# `helm list -n finops`'s own CHART column. The repo URL and chart name themselves (opencost-
# charts / https://opencost.github.io/opencost-helm-chart, chart "opencost") were confirmed
# earlier, from opencost.io's own installation docs (fetched 2026-10-07).
OPENCOST_CHART_VERSION=2.5.32
OPENCOST_HELM_REPO=https://opencost.github.io/opencost-helm-chart

# --- Phase 15: Security / supply chain (Sealed Secrets) ----------------------------------------
# bitnami-labs.github.io is the same category of repo-index page this file already documents as
# unreachable from this sandbox (Loki/Tempo, OpenCost above) -- confirmed again here with a direct
# curl: a hard connect_rejected from the egress proxy, not a timeout, while raw.githubusercontent.
# com and github.com/.../releases/download/... both work fine. So the same two-step: left
# unpinned, scripts/bootstrap/sealed-secrets.sh installs without --version and prints whatever
# Helm actually resolves, to be pinned in a follow-up commit once a real target-machine install
# confirms it (the same thing OpenCost's own history above already did). The main branch's
# helm/sealed-secrets/Chart.yaml (fetched for real via raw.githubusercontent.com, 2026-10-13)
# showed version: 2.20.0, appVersion: 0.40.0 at that moment -- a data point for what to expect,
# not a pin, since "main branch right now" and "what helm install actually resolves" are not the
# same claim.
SEALED_SECRETS_HELM_REPO=https://bitnami.github.io/sealed-secrets
SEALED_SECRETS_CHART_VERSION=2.20.0

# kubeseal (the CLI, run against the controller to produce a SealedSecret) must match the
# controller's appVersion -- its wire format is versioned per release, unlike a client that just
# talks to a stable API. Pinned to 0.40.0, matching the Chart.yaml appVersion read above.
# Unlike k3d/gitleaks/actionlint above, this release publishes no discoverable checksums.txt
# asset: checksums.txt, kubeseal-0.40.0-checksums.txt, sealed-secrets-0.40.0-checksums.txt and
# kubeseal_0.40.0_checksums.txt all 404'd when checked for real against the v0.40.0 release on
# github.com (2026-10-13). So KUBESEAL_SHA256_AMD64/ARM64 below are not copied from a published
# checksum file -- they are the sha256 of the actual release tarballs, computed directly in this
# sandbox after downloading each one for real from the same github.com/.../releases/download/
# URL scripts/bootstrap/install-tools.sh itself fetches (confirmed reachable from this sandbox's
# egress proxy; bitnami-labs.github.io is not). Re-verify independently on the target machine
# before trusting a tenant secret's encryption to this binary -- sha256sum the same file there.
KUBESEAL_VERSION=v0.40.0
KUBESEAL_SHA256_AMD64=9314c35916646e9d59c8f06b1314574b4e79c4d76f079433607ed7b697bb5eb7
KUBESEAL_SHA256_ARM64=d82f01e9226d194ca7ebc13e3619edefd596b5b433582bcec3d5a8e8b1a03123
